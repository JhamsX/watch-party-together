# Server-side only. Never prefix database credentials with VITE_.
NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only when the server is behind exactly one trusted reverse proxy (e.g. Nginx).
TRUST_PROXY=0

# Option A: local MySQL installed on your computer
DATABASE_URL="mysql://watchparty_app:replace_with_a_strong_password@127.0.0.1:3306/watchparty"
# Prisma CLI migration connection; can match DATABASE_URL locally. Use a DDL-enabled user in production.
DIRECT_URL="mysql://watchparty_app:replace_with_a_strong_password@127.0.0.1:3306/watchparty"
# Disposable schema used by prisma migrate dev; never point this at the main database.
SHADOW_DATABASE_URL="mysql://watchparty_app:replace_with_a_strong_password@127.0.0.1:3306/watchparty_shadow"

# Required for signed account tokens (generate with: openssl rand -base64 48)
JWT_SECRET=replace_with_a_long_random_secret

# For production, set CLIENT_ORIGIN to the public site origin, e.g. https://watch.example.com
# Set a strong password and keep this file outside source control.
